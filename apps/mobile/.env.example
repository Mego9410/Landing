# Copy to .env for local development. Variables starting EXPO_PUBLIC_ are bundled into the app, so never put secrets here.

# Where the app's API lives once there is one (for example the web app's /api routes).
EXPO_PUBLIC_API_URL=http://localhost:3000

# RevenueCat's public iOS SDK key (it's meant to ship in the app). Leave empty and subscriptions stay off: no paywall,
# which suits previews and a free TestFlight beta. Set it in the EAS environment for builds that should charge.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
