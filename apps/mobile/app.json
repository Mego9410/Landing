{
  "expo": {
    "name": "Landing",
    "slug": "landing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "landing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yourcompany.landing",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourcompany.landing",
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F4",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#1F1C23",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sharing",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Landing reads your weight and steps to show your 7-day trend and answer your daily check-in.",
          "NSHealthUpdateUsageDescription": "Landing saves the weigh-ins you enter to Apple Health, so they're in one place."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eb04d207-c0e2-464e-8bee-5e6f711bc27f"
    },
    "extra": {
      "eas": {
        "projectId": "eb04d207-c0e2-464e-8bee-5e6f711bc27f"
      }
    }
  }
}
