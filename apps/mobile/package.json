{
  "name": "@landing/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "The Landing iPhone app (Expo).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios --profile production",
    "build:preview": "eas build --platform ios --profile preview",
    "web:export": "expo export --platform web --output-dir dist",
    "web:phone": "expo export --platform web --output-dir dist && node scripts/pack-web.mjs dist dist/landing-app.html",
    "update:preview": "eas update --branch preview --message \"Preview\"",
    "build:dev": "eas build --profile development",
    "test": "tsx --tsconfig tsconfig.json --test src/test/*.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ui": "~57.0.21",
    "@kingstinct/react-native-healthkit": "^16.0.0",
    "@landing/content": "workspace:*",
    "@landing/design-system": "workspace:*",
    "@landing/engine": "workspace:*",
    "@landing/motion": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-healthkit/core": "16.0.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-purchases": "^10.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
