# Copy to .env.local for local development. Set the same variables in Vercel → Project → Settings → Environment Variables.

# The public URL of the site, used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Neon, added by the Vercel integration). Leave empty locally: an embedded Postgres in .data/ is used.
# DATABASE_URL=

# Accounts (see docs/accounts.md). Locally these can stay empty: codes print in the terminal.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# RESEND_API_KEY=
# EMAIL_FROM=Steadie <hello@example.com>
# APPLE_BUNDLE_ID=com.getsteadieapp.app
# REVIEW_EMAIL=
# REVIEW_CODE=
# Extra origins allowed to call the account API from a browser (the app's web build), comma-separated.
# APP_WEB_ORIGINS=
