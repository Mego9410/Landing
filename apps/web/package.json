{
  "name": "@landing/web",
  "version": "1.0.0",
  "private": true,
  "description": "The Steadie website: brand, guides, legal pages and the app's account API.",
  "scripts": {
    "dev": "node scripts/copy-prototype.mjs && next dev",
    "build": "node scripts/copy-prototype.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "test:auth": "tsx --tsconfig tsconfig.json scripts/test-auth.mts",
    "test:sync": "tsx --tsconfig tsconfig.json scripts/test-sync.mts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@landing/content": "workspace:*",
    "@landing/design-system": "workspace:*",
    "@landing/motion": "workspace:*",
    "@neondatabase/serverless": "1.2.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@landing/prototype": "workspace:*",
    "@types/node": "^22",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  }
}
