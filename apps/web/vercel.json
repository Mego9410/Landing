{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @landing/web...",
  "buildCommand": "pnpm run build",
  "ignoreCommand": "npx turbo-ignore @landing/web --fallback=HEAD^1",
  "regions": [
    "lhr1"
  ],
  "crons": [
    {
      "path": "/api/cron/guides",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/recap",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/cron/recap",
      "schedule": "0 18 * * 0"
    }
  ]
}
